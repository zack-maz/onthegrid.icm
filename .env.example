# === REQUIRED for deployment ===

# Upstash Redis (create free instance at https://console.upstash.com)
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# === SERVER CONFIG (optional — defaults shown) ===

# HTTP listen port for local Express server. Vercel ignores this.
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# CORS origin allow-list. Comma-separated list, or '*' for any.
CORS_ORIGIN=*

# Pino logger level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# === OPTIONAL DATA SOURCES — graceful degradation if missing ===

# OpenSky Network (register at https://opensky-network.org)
# OAuth2 client credentials — create at OpenSky Dashboard -> API Clients
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# AISStream.io (register at https://aisstream.io, sign in via GitHub)
# Copy API key from Dashboard
AISSTREAM_API_KEY=your-aisstream-api-key

# ADS-B Exchange via RapidAPI (subscribe at https://rapidapi.com/adsbx/api/adsbexchange-com1)
ADSB_EXCHANGE_API_KEY=your-rapidapi-key

# ACLED (register at https://acleddata.com) — adapter present but inactive
# Use your registration email and password
ACLED_EMAIL=your-email@example.com
ACLED_PASSWORD=your-password

# Cerebras (register at https://cloud.cerebras.ai, create API key at Settings -> API Keys)
# Free tier: 1M tokens/day, 30 RPM. Used for LLM event extraction (primary provider).
CEREBRAS_API_KEY=your-cerebras-api-key

# Groq (register at https://console.groq.com, create API key at API Keys)
# Free tier: 200K tokens/day, 30 RPM. Used as fallback when Cerebras is unavailable.
GROQ_API_KEY=your-groq-api-key

# --- Phase 27.4: LLM pipeline rollout flag ---
# 'true' (default) activates the v2 extractor — structured place hierarchy,
# enriched prompts (news + Bellingcat + temporal context blocks), layered
# resolver with 6 provenance paths, DLQ, circuit breaker, token budget.
# 'false' keeps the v1 extractor path for rollback per D-26/D-40.
# Read at request-time — no rebuild required to flip.
# Runtime override: the DevApiStatus Topbar pill (dev builds) POSTs to
# /api/events/llm-pipeline to swap versions without an env/restart. The
# in-memory override takes precedence over this env value until cleared.
LLM_PIPELINE_V2=true

# --- Phase 27.4.1: LLM extractor per-batch timeout (watchdog) ---
# Hard-kill threshold in milliseconds for any single LLM batch call.
# If Cerebras (or Groq) fails to return within this window, the batch is
# aborted, the group is routed to the DLQ with reason='timeout_watchdog',
# and the extractor continues with the next batch. A soft-warn entry is
# also logged at 60 seconds so p95 can be tuned without redeploys.
# Default 90000 (90s); bump to 120000-180000 if Cerebras is running slow
# under observed "high traffic" conditions.
LLM_BATCH_TIMEOUT_MS=90000

# === EVENT PIPELINE TUNING ===

# Minimum composite confidence (0-1) for a GDELT event to be retained
EVENT_CONFIDENCE_THRESHOLD=0.35

# Minimum independent NumSources for a GDELT row to be considered
EVENT_MIN_SOURCES=2

# Multiplicative confidence penalty (0-1) when ActionGeo coords match a city centroid
EVENT_CENTROID_PENALTY=0.7

# Comma-separated CAMEO base codes to exclude from event ingestion
EVENT_EXCLUDED_CAMEO=180,192

# Confidence boost (0-1) when a Bellingcat article corroborates an event
BELLINGCAT_CORROBORATION_BOOST=0.2

# Minimum relevance score (0-1) for news articles to be kept after filtering
NEWS_RELEVANCE_THRESHOLD=0.7

# === Phase 27.4.3: free-claude-code routing (NVIDIA NIM + OpenRouter) ===
# NVIDIA NIM (free key from https://build.nvidia.com/settings/api-keys, prefix `nvapi-`).
# 40 req/min free, no documented daily token cap. v3 pipeline primary provider.
NVIDIA_NIM_API_KEY=your-nvapi-key

# OpenRouter (optional fallback — free key from https://openrouter.ai/settings/keys).
# Free models cap ~100-200 req/day each; v3 cascade falls through here on
# NVIDIA NIM exhaust per Phase 27.4.3 D-09.
OPENROUTER_API_KEY=your-openrouter-key

# --- Phase 27.4.3: v3 pipeline flag ---
# 'true' activates the v3 extractor (free-claude-code routing). Default 'false'
# until D-16 cutover gate is met. Runtime override:
# POST /api/events/llm-pipeline {version: 'v3'}.
LLM_PIPELINE_V3=false

# === Phase 27.4.4: v3 latency remediation ===
# D-04: Adaptive batching opt-in. When 'true', timed-out batches split 1+1 and
# retry once at smaller size; failed retries DLQ-route with reason v3:adaptive-retry-fail.
# Default OFF — activate via V3_ADAPTIVE_BATCH=true if production reveals long-tail
# the bake-off didn't predict.
V3_ADAPTIVE_BATCH=false

# D-18: Lineage-hash pre-filter opt-in. When 'true', re-runs skip groups whose
# lineage hash matches a cached enriched event < 7d old (cuts ~196→~30-50 batches
# on stable runs). Default OFF — activate post-cutover when ongoing-ops cost
# optimization matters more than telemetry purity.
V3_LINEAGE_PREFILTER=false

# D-13: Env-tunable Trigger 1 watchdog-recurrence threshold for auto-rollback.
# Default 2 (lowered from hardcoded 3). Raises consistency with strict Gate B
# watchdog=0 while letting single timeouts (NIM cold-start, network blip)
# recover without spurious flip.
V3_WATCHDOG_ROLLBACK_THRESHOLD=2

# Phase 27.4.4 Plan 02: parallel v3 batch processing.
# Sequential `await` per batch was running ~2 req/min against a NIM ceiling
# of 40 req/min — leaving ~95% of the rate budget unused. Default 12 lands
# ~26 req/min steady-state with ~27s/batch latency (well under cap, with
# headroom for cold-start + per-batch variance). Drives 197-batch dev runs
# from ~95 min → ~10 min.
#
# Tuning knob:
#   - LLM_V3_CONCURRENCY=1   reverts to fully sequential (rollback path)
#   - LLM_V3_CONCURRENCY=12  default; safe under NIM 40/min cap
#   - LLM_V3_CONCURRENCY=20  saturates NIM but risks 429s mid-run
LLM_V3_CONCURRENCY=12

# D-14: Vercel cron secret. Vercel automatically attaches as
# `Authorization: Bearer ${CRON_SECRET}` when invoking cron paths in vercel.json.
# /api/cron/eval verifies by comparing the header to process.env.CRON_SECRET.
# Random ≥ 16-char string. Leave empty in dev to preserve un-authed behavior.
CRON_SECRET=your-random-secret-min-16-chars

# === Phase 27.4.4 Plan 02: dashboard auth gate ===
# Bearer-token gate for the operator dashboard surfaces:
#   - GET  /api/events/llm-pipeline    (state read)
#   - POST /api/events/llm-pipeline    (cutover flip — Plan 02 Task 5)
#   - POST /api/events/llm-replay/:id  (per-group replay; fires LLM tokens)
#   - GET  /api/dashboard/auth-check   (client gate validation)
#
# Server middleware (server/middleware/dashboardAuth.ts):
#   - NODE_ENV !== 'production'           → bypass (dev convenience)
#   - NODE_ENV === 'production' + empty   → 503 auth_not_configured
#   - NODE_ENV === 'production' + match   → next()
#
# Replaces the prior `NODE_ENV === 'production'` 404 gates that made the
# cutover endpoint unreachable from the operator's laptop in production.
# Generate with: `openssl rand -hex 32`. Set the SAME value in `.env.local`
# (dev parity for local prod-mode testing) and Vercel prod env via
# `vercel env add DASHBOARD_PASSWORD production`.
DASHBOARD_PASSWORD=

# === Phase 27.4.4 D-20 Option B: dev/prod Redis key isolation ===
# When set (e.g. `dev:`), every key passing through the wrapped redis client
# gets the prefix applied. Production NEVER sets this — prod keys remain
# `events:llm:v3`. Dev sets `CACHE_KEY_PREFIX=dev:` in .env.local so dev runs
# land at `dev:events:llm:v3` and never collide with the live prod cache.
# Defense-in-depth — survives operator forgetting to swap Upstash databases.
# To clean up after a phase: `redis.keys('dev:*')` + bulk delete.
CACHE_KEY_PREFIX=

# ---------------------------------------------------------------------------
# Phase 28.1 D-12 — Operator-tunable polling intervals + thresholds
# ---------------------------------------------------------------------------
# All defaults preserve pre-W5 behavior. Override at deploy time via Vercel
# env vars to tune cadence without rebuild. All client-tier vars are VITE_*
# prefixed so Vite exposes them to the browser bundle.
#
# Tier note: these are CLIENT env vars consumed in src/. The pre-W5 runtime
# values are the defaults below — leaving these unset reproduces pre-W5
# behavior exactly. Override only when tuning incident response.

# Polling intervals (milliseconds)
VITE_POLL_FLIGHTS_MS=5000              # Flight position polling (default 5s)
VITE_STALE_FLIGHT_MS=60000             # Flight stale threshold; clears positions older than this (default 60s)
VITE_POLL_SHIPS_MS=30000               # Ship position polling (default 30s)
VITE_POLL_EVENTS_MS=900000             # GDELT event polling (default 15min)
VITE_POLL_NEWS_MS=900000               # News cluster polling (default 15min)
VITE_POLL_MARKETS_MS=300000            # Yahoo Finance polling (default 5min — actual pre-W5 value, not 60s)
VITE_POLL_WATER_PRECIP_MS=21600000     # Open-Meteo precip polling (default 6h)
VITE_POLL_WEATHER_MS=1800000           # Open-Meteo weather grid polling (default 30min) — added per W3 triage
VITE_POLL_LLM_STATUS_ACTIVE_MS=5000    # LLM-status polling while pipeline is active (default 5s)
VITE_POLL_LLM_STATUS_IDLE_MS=30000     # LLM-status polling while pipeline is idle (default 30s)

# Spatial thresholds (kilometers)
VITE_ATTACK_RADIUS_KM=5                # Site/event attack-status cross-reference radius (default 5km)
VITE_PROXIMITY_ALERT_KM=5              # Flight/ship proximity-to-site alert radius (default 5km — actual pre-W5 value, not 50km)

# Severity scoring (hours)
VITE_SEVERITY_HALF_LIFE_HOURS=24       # Recency-decay half-life; default 24h preserves pre-W5 ranking
