          class="mt-1 max-h-40 overflow-y-auto text-[10px] text-text-muted/80"
          data-testid="actor-quality-list"
        >
          <li
            class="flex items-baseline gap-2 py-0.5"
            data-testid="actor-quality-row-evt-1"
          >
            <span
              class="font-mono text-[color:var(--color-faction-disputed)]"
            >
              raw-cameo
            </span>
            <span
              class="truncate font-mono text-text-muted/40"
            >
              evt-1
            </span>
            <span
              class="truncate text-text-muted/70"
            >
              USMIL
            </span>
          </li>
        </ul>
        <div
          class="mt-4"
        >
          <button
            aria-controls="operator-drawer"
            aria-expanded="false"
            aria-label="Open operator controls"
            class="rounded-md border border-white/10 px-2 py-1 text-[10px] hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue/60 focus-visible:ring-offset-1 focus-visible:ring-offset-black"
            data-testid="operator-drawer-trigger"
            type="button"
          >
            Operator Controls
          </button>
        </div>
      </section>
    </div>
  </section>
</div>
`;
