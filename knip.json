{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.tsx",
    "server/vercel-entry.ts",
    "server/index.ts",
    "scripts/*.{ts,js}",
    "vite.config.ts",
    "eslint.config.js"
  ],
  "project": ["src/**/*.{ts,tsx}", "server/**/*.ts"],
  "ignore": [".claude/**", "dist/**", "api/**", "load-test-results/**", "src/test/__mocks__/**"],
  "ignoreDependencies": [
    "@deck.gl/core",
    "@deck.gl/extensions",
    "@deck.gl/layers",
    "@deck.gl/mapbox",
    "@vis.gl/react-maplibre",
    "maplibre-gl"
  ]
}
